{
  "name": "fluxo-pessoal",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "install:ci": "bash scripts/install-ci.sh",
    "dev": "vite",
    "build": "bash scripts/build-verified.sh",
    "start": "vinext start",
    "test": "npm run test:core",
    "test:core": "node --experimental-strip-types --test \"core/**/*.test.ts\"",
    "test:server": "node --experimental-strip-types --test \"server/**/*.test.ts\"",
    "test:artifact": "npm run build && node --test tests/rendered-html.test.mjs",
    "test:imports": "node --experimental-strip-types --test tests/import-parser.test.ts",
    "test:rewards": "node --experimental-strip-types --test tests/rewards.test.ts",
    "test:layout": "node --experimental-strip-types --test tests/dashboard-layout.test.ts",
    "test:mobile-auth": "node --experimental-strip-types --test tests/mobile-auth.test.ts",
    "test:sync": "node --experimental-strip-types --test tests/sync-v1.test.ts",
    "test:theme": "node --test tests/theme.test.mjs",
    "test:ocr": "node --experimental-strip-types --test tests/receipt-ocr.test.ts",
    "test:travel": "node --experimental-strip-types --test tests/travel-mode.test.ts",
    "test:cards": "node --experimental-strip-types --test tests/card-management.test.ts",
    "test:installments": "node --experimental-strip-types --test tests/installments.test.ts",
    "validate:artifact": "bash scripts/validate-artifact.sh",
    "lint": "bash scripts/sites-env.sh -- eslint . --ignore-pattern dist --ignore-pattern .next",
    "db:generate": "bash scripts/sites-env.sh -- drizzle-kit generate",
    "seed:demo": "node scripts/seed-demo.mjs",
    "smoke": "node scripts/smoke.mjs"
  },
  "dependencies": {
    "drizzle-orm": "0.45.2",
    "lucide-react": "^0.468.0",
    "next": "16.2.6",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vinext": "0.0.50",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "type": "module",
  "displayName": "Fluxo Pessoal"
}
