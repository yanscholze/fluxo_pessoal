# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/mobile/node_modules
/mobile/.expo
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
next-env.d.ts
*.tsbuildinfo
/dist/
/.wrangler/
# Cache de build do vinext, incluindo as fontes baixadas do Google.
/.vinext/
/.sites-runtime/
/outputs/
/work/

# chaves e segredos — nunca versionar
*.keystore
*.jks
*.p12
*.pfx
google-services.json
