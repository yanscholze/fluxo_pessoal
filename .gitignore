# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/mobile/node_modules
/mobile/.expo
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# Segredos do Worker no desenvolvimento local. O Wrangler lê este arquivo e o
# expõe como `env.X`, igual ao que `wrangler secret put` faz em produção — e
# por isso ele nunca pode ser versionado.
.dev.vars
.dev.vars.*
!.dev.vars.example

# vercel
.vercel

# typescript
next-env.d.ts
*.tsbuildinfo
/dist/
/.wrangler/
# Cache de build do vinext, incluindo as fontes baixadas do Google.
/.vinext/
/.sites-runtime/
# O mesmo cache aparece dentro do workspace quando o npm roda de lá.
mobile/.sites-runtime/
/outputs/
/work/

# chaves e segredos — nunca versionar
*.keystore
*.jks
*.p12
*.pfx
google-services.json

# Skills de agente instaladas por `npx skills add`. São ferramenta de quem
# desenvolve, não parte do produto: cada pessoa instala as que usa, e o
# conteúdo vem de repositórios de terceiros que este projeto não revisa a
# cada atualização. O skills-lock.json só faz sentido junto com elas.
/.agents/
/.claude/skills/
/skills-lock.json

# Exportações do banco. Contêm lançamentos financeiros reais — e este
# repositório é público. Backup vive na máquina, nunca no histórico.
backups/
*.sql.gz

# Artefatos de build do aplicativo. Um APK tem 74 MB e é regerável.
builds/
