# Segredo de criptografia do servidor para as integrações pessoais.
# Gere UMA vez com `openssl rand -base64 32` e guarde o valor: substituí-lo
# impede a leitura das chaves que as contas já cadastraram.
# Este arquivo é apenas um modelo. Copie para `.dev.vars`, ignorado pelo Git.
INTEGRATION_ENCRYPTION_KEY=

# Recomendado: cada conta cadastra suas chaves em Configurações → Integrações.
# Opcional: chave Gemini do servidor, EXCLUSIVA do usuário indicado por ID.
# Sem GEMINI_USER_ID a chave abaixo não é usada; nunca é compartilhada entre contas.
# Em produção use secrets do Worker existente. Nunca use prefixos VITE_/NEXT_PUBLIC_.
GEMINI_API_KEY=
GEMINI_USER_ID=
GEMINI_MODEL=gemini-3.8-flash
