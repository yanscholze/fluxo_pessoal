{
  "expo": {
    "name": "Fluxo",
    "slug": "fluxo-pessoal",
    "version": "0.5.0",
    "owner": "yan.scholze",
    "scheme": "fluxo",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "icon": "./assets/icon.png",
    "android": {
      "package": "com.fluxo.pessoal",
      "versionCode": 10,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "monochromeImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#35b7aa"
      },
      "predictiveBackGestureEnabled": true
    },
    "plugins": [
      ["expo-secure-store", { "configureAndroidBackup": true }],
      "expo-sqlite"
    ],
    "extra": { "eas": { "projectId": "13821e67-9f56-418c-a8bd-fe90eaf83620" } }
  }
}
